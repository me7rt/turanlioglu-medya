---
// Açılış galerisi: bölümü baştan sona kaplayan, zıt yönlere kayan dikey görsel sütunları.
// Tamamen süs (aria-hidden). Mert'in kararı: durdur/başlat düğmesi konmayacak.
import Img from './Img.astro';
const label: Record<string, string> = { social: 'Sosyal medya', web: 'Web tasarım', ads: 'Dijital reklam', content: 'İçerik ve video', seo: 'SEO ve GEO' };
const keys = ['social', 'hero', 'seo', 'content', 'web', 'team', 'ads', 'blogGeo'];
// 9 sütun; her sütun farklı sırayla başlar
const cols = Array.from({ length: 9 }, (_, c) => Array.from({ length: 4 }, (_, i) => keys[(c * 3 + i * 2) % keys.length]));
---
<div class="hg" data-hero-gallery>
  <div class="hg-cols" aria-hidden="true">
    {cols.map((col, ci) => (
      <div class:list={['hg-col', `hg-col--${ci}`]}>
        <div class="hg-track">
          {[0, 1].map(() => col.map((k, i) => (
            <figure class="hg-card">
              <Img name={k} decorative sizes="(min-width: 900px) 15vw, 34vw" ratio={(i + ci) % 2 ? '3/4' : '1/1'} />
              {label[k] && <figcaption class="hg-chip"><span class="hg-dot"></span>{label[k]}</figcaption>}
            </figure>
          )))}
        </div>
      </div>
    ))}
  </div>
</div>
<style>
  /* Sütunlar eğik ve açılı bir düzlemde durur (hafif 3B), bölümü baştan sona kaplar */
  .hg { position: absolute; inset: 0; overflow: hidden; perspective: 1800px;
    mask-image: linear-gradient(transparent, #000 8%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(transparent, #000 8%, #000 88%, transparent); }
  .hg-cols {
    position: absolute; z-index: 0; inset: -40% -8% -40% -8%; display: grid; grid-template-columns: repeat(9, 1fr); gap: 16px; padding-inline: 14px; overflow: hidden;
    transform: rotateX(14deg) rotateY(-10deg) rotateZ(13deg); transform-origin: 60% 50%;
  }
  .hg-col:nth-child(odd) { margin-top: 6vh; }
  .hg-track { display: grid; gap: 14px; will-change: transform; }
  :global(.motion) .hg-track { animation: hg-up 44s linear infinite; }
  :global(.motion) .hg-col:nth-child(even) .hg-track { animation-name: hg-down; animation-duration: 52s; }
  :global(.motion) .hg-col:nth-child(3n) .hg-track { animation-duration: 48s; }
  .hg.offscreen .hg-track { animation-play-state: paused !important; }
  @keyframes hg-up { to { transform: translate3d(0, calc(-50% - 7px), 0); } }
  @keyframes hg-down { from { transform: translate3d(0, calc(-50% - 7px), 0); } to { transform: translate3d(0, 0, 0); } }
  .hg-card { position: relative; margin: 0; border-radius: 22px; backface-visibility: hidden; overflow: hidden; box-shadow: 0 18px 40px -22px rgb(6 42 45 / 0.55); }
  .hg-card :global(.img-frame) { border-radius: 0; }
  .hg-card :global(img) { width: 100%; height: 100%; object-fit: cover; }
  .hg-chip {
    position: absolute; left: 10px; bottom: 10px; display: inline-flex; align-items: center; gap: 0.45rem; max-width: calc(100% - 20px);
    padding: 0.4rem 0.8rem 0.4rem 0.45rem; border-radius: 999px; background: rgb(255 255 255 / 0.92); color: var(--petrol);
    font-size: 0.82rem; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .hg-dot { flex: none; width: 1.3rem; height: 1.3rem; border-radius: 50%; background: var(--turkuaz); box-shadow: inset 0 0 0 4px var(--petrol); }
  @media (max-width: 1100px) { .hg-cols { grid-template-columns: repeat(6, 1fr); } .hg-col:nth-child(n+7) { display: none; } }
  @media (max-width: 700px) { .hg-cols { grid-template-columns: repeat(4, 1fr); gap: 10px; padding-inline: 10px; inset: -35% -25% -35% -25%; } .hg-track { gap: 10px; } .hg-col:nth-child(n+5) { display: none; } .hg-chip { font-size: 0.72rem; } }
</style>
