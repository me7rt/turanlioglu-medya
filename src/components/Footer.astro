---
import Logo from './Logo.astro';
import { site, services } from '../data/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, v]) => v);
---
<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a class="logo" href={url('/')} style="color:#fff"><Logo /><span>{site.name}</span></a>
        <p style="margin-top:1rem">{site.tagline}</p>
        <p>{site.city}, Türkiye</p>
      </div>
      <div>
        <h2>Hizmetler</h2>
        <ul>{services.map((s) => <li><a href={url(`/hizmetler/${s.slug}/`)}>{s.name}</a></li>)}</ul>
      </div>
      <div>
        <h2>Kurumsal</h2>
        <ul>
          <li><a href={url('/hakkimizda/')}>Hakkımızda</a></li>
          <li><a href={url('/blog/')}>Blog</a></li>
          <li><a href={url('/sss/')}>Sık sorulan sorular</a></li>
          <li><a href={url('/iletisim/')}>İletişim</a></li>
        </ul>
      </div>
      <div>
        <h2>Takip edin</h2>
        {socials.length ? (
          <ul>{socials.map(([k, v]) => <li><a href={v} rel="me noopener" target="_blank">{k[0].toUpperCase() + k.slice(1)}</a></li>)}</ul>
        ) : (
          <p class="todo">[DOLDURULACAK: sosyal medya hesapları]</p>
        )}
      </div>
    </div>
    <p class="footer-mark" aria-hidden="true">Turanlıoğlu</p>
    <div class="footer-bottom">
      <span>© {year} {site.name}</span>
      <nav aria-label="Yasal" style="display:flex;gap:1.25rem;flex-wrap:wrap">
        <a href={url('/yasal/gizlilik-politikasi/')}>Gizlilik politikası</a>
        <a href={url('/yasal/kvkk-aydinlatma-metni/')}>KVKK aydınlatma metni</a>
        <a href={url('/yasal/cerez-politikasi/')}>Çerez politikası</a>
        <button type="button" class="footer-link" data-motion-toggle aria-pressed="false">Animasyonları kapat</button>
      </nav>
    </div>
  </div>
</footer>
