---
import Logo from './Logo.astro';
import Arcs from './Arcs.astro';
import { site, services } from '../data/site';
import { url } from '../lib/url';
const year = new Date().getFullYear();
const socials = Object.entries(site.social).filter(([, v]) => v);
const word = 'Turanlıoğlu';
---
<footer class="site-footer on-dark">
  <div class="ft-orbs" aria-hidden="true"><i></i><i></i><i></i><b class="ft-spot" data-ft-spot></b></div>
  <Arcs class="ft-arcs" tone="light" />
  <div class="wrap">
    <div class="ft-cta glass">
      <p class="ft-cta-title">Bir sonraki adımı<br />birlikte atalım.</p>
      <a class="ft-cta-btn" href={url('/iletisim/')} data-cursor="Tanışalım">
        <span>Teklif al</span>
        <span class="ft-cta-ic" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M7 17 17 7M9 7h8v8" /></svg></span>
      </a>
    </div>

    <div class="ft-grid glass">
      <div class="ft-brand">
        <a class="logo" href={url('/')}><Logo /><span>{site.name}</span></a>
        <p>{site.tagline}</p>
        <p class="ft-city"><span class="ft-pulse" aria-hidden="true"></span>{site.city}, Türkiye</p>
      </div>
      <nav aria-labelledby="ft-hizmetler">
        <h2 id="ft-hizmetler">Hizmetler</h2>
        <ul>{services.map((s) => <li><a class="ft-link" href={url(`/hizmetler/${s.slug}/`)}>{s.name}</a></li>)}</ul>
      </nav>
      <nav aria-labelledby="ft-kurumsal">
        <h2 id="ft-kurumsal">Kurumsal</h2>
        <ul>
          <li><a class="ft-link" href={url('/hakkimizda/')}>Hakkımızda</a></li>
          <li><a class="ft-link" href={url('/blog/')}>Blog</a></li>
          <li><a class="ft-link" href={url('/sss/')}>Sık sorulan sorular</a></li>
          <li><a class="ft-link" href={url('/iletisim/')}>İletişim</a></li>
        </ul>
      </nav>
      <div>
        <h2>Takip edin</h2>
        {socials.length ? (
          <ul>{socials.map(([k, v]) => <li><a class="ft-link" href={v} rel="me noopener" target="_blank">{k[0].toUpperCase() + k.slice(1)}</a></li>)}</ul>
        ) : (
          <p class="todo">[DOLDURULACAK: sosyal medya hesapları]</p>
        )}
      </div>
    </div>
  </div>

  <p class="ft-mark" aria-hidden="true" data-ft-mark>{[...word].map((c) => <span class:list={{ 'g-sade': 'ğua'.includes(c), 'g-gap': c === 'ğ' }}>{c}</span>)}</p>

  <div class="wrap ft-bottom-wrap"><div class="ft-bottom glass">
    <span>© {year} {site.name}</span>
    <nav aria-label="Yasal" class="ft-legal">
      <a class="ft-link" href={url('/yasal/gizlilik-politikasi/')}>Gizlilik politikası</a>
      <a class="ft-link" href={url('/yasal/kvkk-aydinlatma-metni/')}>KVKK aydınlatma metni</a>
      <a class="ft-link" href={url('/yasal/cerez-politikasi/')}>Çerez politikası</a>
    </nav>
    <a class="ft-top" href="#icerik" aria-label="Sayfanın başına dön">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 19V5M6 11l6-6 6 6" /></svg>
    </a>
  </div></div>
</footer>
<style>
  .site-footer {
    position: relative; overflow: hidden; isolation: isolate; background: var(--petrol); color: #c9e2df;
    padding-top: clamp(4rem, 7vw, 7rem); border-radius: clamp(24px, 3vw, 44px) clamp(24px, 3vw, 44px) 0 0; margin-top: calc(-1 * clamp(24px, 3vw, 44px));
  }
  /* Arkada süzülen ışık küreleri: cam paneller bunları buzlu gösterir */
  .ft-orbs { position: absolute; inset: 0; z-index: -1; pointer-events: none; overflow: hidden; }
  .ft-orbs i, .ft-spot { position: absolute; border-radius: 50%; filter: blur(70px); }
  .ft-orbs i:nth-child(1) { width: 46vw; height: 46vw; left: -12vw; top: 4%; background: rgb(64 224 208 / 0.34); }
  .ft-orbs i:nth-child(2) { width: 34vw; height: 34vw; right: -8vw; top: 30%; background: rgb(27 111 103 / 0.9); }
  .ft-orbs i:nth-child(3) { width: 30vw; height: 30vw; left: 35%; bottom: -10vw; background: rgb(48 213 200 / 0.3); }
  :global(.motion) .ft-orbs i:nth-child(1) { animation: orb1 18s ease-in-out infinite alternate; }
  :global(.motion) .ft-orbs i:nth-child(2) { animation: orb2 22s ease-in-out infinite alternate; }
  :global(.motion) .ft-orbs i:nth-child(3) { animation: orb3 16s ease-in-out infinite alternate; }
  @keyframes orb1 { to { transform: translate(28vw, 12vh) scale(1.15); } }
  @keyframes orb2 { to { transform: translate(-30vw, -10vh) scale(0.9); } }
  @keyframes orb3 { to { transform: translate(-18vw, -26vh) scale(1.2); } }
  .ft-spot { width: 380px; height: 380px; left: 0; top: 0; margin: -190px 0 0 -190px; background: rgb(64 224 208 / 0.35); opacity: 0; transition: opacity 0.5s; filter: blur(60px); }

  /* Buzlu cam */
  .glass {
    position: relative; border-radius: clamp(20px, 2.4vw, 32px);
    background: linear-gradient(135deg, rgb(255 255 255 / 0.09), rgb(255 255 255 / 0.02)), rgb(6 42 45 / 0.38);
    backdrop-filter: blur(22px) saturate(160%); -webkit-backdrop-filter: blur(22px) saturate(160%);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.22), inset 0 0 0 1px rgb(255 255 255 / 0.1), 0 30px 60px -30px rgb(0 0 0 / 0.5);
  }
  /* Kenarda gezinen ışık çizgisi */
  .glass::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: radial-gradient(180px 120px at var(--mx, 50%) var(--my, 0%), rgb(64 224 208 / 0.9), transparent 70%);
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude;
    opacity: var(--edge, 0); transition: opacity 0.4s;
  }
  .glass:hover { --edge: 1; }
  .site-footer :global(.ft-arcs) { right: -3%; top: -4%; width: min(40vw, 420px); transform: scale(-1, -1); z-index: -1; opacity: 0.5; }

  /* Çağrı alanı */
  .ft-cta { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 2rem; padding: clamp(2rem, 4vw, 3.5rem); }
  .ft-cta-title { margin: 0; max-width: none; font-family: var(--font-display); font-weight: 650; font-size: var(--fs-4); line-height: 0.98; letter-spacing: -0.035em; color: var(--beyaz); font-variation-settings: 'wdth' 88; }
  .ft-cta-btn {
    display: inline-flex; align-items: center; gap: 1rem; padding: 0.6rem 0.6rem 0.6rem 2rem; border-radius: 999px;
    background: var(--turkuaz); color: var(--petrol) !important; text-decoration: none; font-weight: 700; font-size: var(--fs-1);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .ft-cta-ic { display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: var(--petrol); color: var(--turkuaz); transition: transform 0.5s var(--ease); }
  .ft-cta-ic svg, .ft-top svg { width: 45%; height: 45%; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .ft-cta-btn:hover { transform: translateY(-3px); box-shadow: 0 0 0 6px rgb(64 224 208 / 0.18), 0 20px 50px -10px rgb(64 224 208 / 0.5); }
  .ft-cta-btn:hover .ft-cta-ic { transform: rotate(45deg); }

  /* Bağlantılar */
  .ft-grid { display: grid; grid-template-columns: 1.6fr 1fr 1fr 1fr; gap: 2.5rem; padding: clamp(2rem, 4vw, 3.5rem); margin-top: 1.25rem; }
  .ft-grid h2 { font: 600 0.95rem var(--font-text); letter-spacing: 0; color: #9ff0e6; margin-bottom: 1.1rem; }
  .ft-grid ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.65rem; }
  .ft-brand .logo { color: var(--beyaz); margin-bottom: 1rem; }
  .ft-city { display: flex; align-items: center; gap: 0.6rem; }
  .ft-pulse { position: relative; width: 10px; height: 10px; border-radius: 50%; background: var(--turkuaz); }
  .ft-pulse::after { content: ''; position: absolute; inset: 0; border-radius: 50%; border: 2px solid var(--turkuaz); }
  :global(.motion) .ft-pulse::after { animation: ft-ping 2.4s ease-out infinite; }
  @keyframes ft-ping { to { transform: scale(3); opacity: 0; } }
  .ft-link { position: relative; color: #e2f2f0; text-decoration: none; background: linear-gradient(var(--turkuaz), var(--turkuaz)) 0 100% / 0 2px no-repeat; transition: background-size 0.35s var(--ease), color 0.2s; padding-bottom: 2px; }
  .ft-link:hover, .ft-link:focus-visible { color: var(--turkuaz); background-size: 100% 2px; }

  /* Dev yazı: harfler sırayla yükselir; üzerine gelinen harf zıplar */
  .ft-mark {
    display: flex; justify-content: center; margin: 0; max-width: none; padding-inline: 1vw; user-select: none; overflow: hidden;
    font-family: var(--font-display); font-weight: 700; font-size: clamp(3.4rem, 17.2vw, 22rem); line-height: 0.8; letter-spacing: -0.05em;
    font-variation-settings: 'wdth' 78; padding: 0.1em 1vw 0.22em; margin: 0.2em 0 0;
  }
  .ft-mark span {
    display: inline-block; pointer-events: auto; padding: 0.06em 0 0.2em; margin-bottom: -0.2em;
    background: linear-gradient(180deg, var(--turkuaz) 15%, rgb(64 224 208 / 0.35) 100%); -webkit-background-clip: text; background-clip: text; color: transparent;
    transition: transform 0.5s var(--ease);
  }
  /* Bricolage'ın iki katlı 'g'si yerine sade, tek katlı 'g' (Instrument Sans) */
  .ft-mark .g-sade { font-family: var(--font-text); font-weight: 700; font-variation-settings: normal; letter-spacing: 0; }
  .ft-mark .g-gap { margin-left: 0.09em; }
  .ft-mark span:hover { transform: translateY(-0.08em); }

  .ft-bottom-wrap { position: relative; z-index: 2; margin-top: 0.5rem; padding-bottom: 1.5rem; }
  .ft-bottom { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; padding: 1rem 1rem 1rem 1.75rem; font-size: 0.9rem; border-radius: 999px; }
  .ft-legal { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; margin-left: auto; }
  .ft-top { display: grid; place-items: center; width: 48px; height: 48px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px rgb(64 224 208 / 0.6); color: var(--turkuaz); transition: background 0.3s, color 0.3s, transform 0.4s var(--ease); }
  .ft-top:hover { background: var(--turkuaz); color: var(--petrol); transform: translateY(-4px); }

  @media (max-width: 900px) { .ft-grid { grid-template-columns: 1fr 1fr; } .ft-brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .ft-legal { margin-left: 0; } .ft-bottom { border-radius: 24px; } .ft-bottom-wrap { margin-top: 0.5rem; } }
</style>
<script>
  // İmleç footer'da gezinirken arkadaki ışık onu takip eder; cam panellerin kenarında ışık dolaşır
  const ft = document.querySelector<HTMLElement>('.site-footer');
  const spot = document.querySelector<HTMLElement>('[data-ft-spot]');
  if (ft && spot && matchMedia('(pointer: fine)').matches) {
    ft.addEventListener('pointermove', (e) => {
      const r = ft.getBoundingClientRect();
      spot.style.opacity = '1';
      spot.style.transform = `translate(${e.clientX - r.left}px, ${e.clientY - r.top}px)`;
      ft.querySelectorAll<HTMLElement>('.glass').forEach((g) => {
        const b = g.getBoundingClientRect();
        g.style.setProperty('--mx', `${e.clientX - b.left}px`);
        g.style.setProperty('--my', `${e.clientY - b.top}px`);
      });
    });
    ft.addEventListener('pointerleave', () => { spot.style.opacity = '0'; });
  }
  // Dev yazı ekrana girerken harfler alttan sırayla yükselir (hareket açıkken)
  const mark = document.querySelector<HTMLElement>('[data-ft-mark]');
  if (mark && document.documentElement.classList.contains('motion') && 'IntersectionObserver' in window) {
    const letters = [...mark.querySelectorAll<HTMLElement>('span')];
    letters.forEach((l) => { l.style.transform = 'translateY(105%)'; l.style.transition = 'none'; });
    new IntersectionObserver((entries, io) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      letters.forEach((l, i) => {
        l.style.transition = `transform 0.9s cubic-bezier(0.2, 0.8, 0.2, 1) ${i * 0.05}s`;
        requestAnimationFrame(() => { l.style.transform = ''; });
        setTimeout(() => { l.style.transition = ''; }, 900 + i * 50);
      });
    }, { threshold: 0.3 }).observe(mark);
  }
</script>
