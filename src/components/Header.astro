---
import Logo from './Logo.astro';
import { nav, site } from '../data/site';
import { url } from '../lib/url';
const current = Astro.url.pathname;
---
<header class="site-header">
  <div class="wrap">
    <a class="logo" href={url('/')} aria-label={`${site.name} ana sayfa`}>
      <Logo />
      <span>{site.name}</span>
    </a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="ana-menu" aria-label="Menüyü aç">
      <svg width="26" height="26" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h18" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <nav class="nav" id="ana-menu" aria-label="Ana menü">
      {nav.map((item) => {
        const href = url(item.href);
        return <a href={href} aria-current={current.startsWith(href) ? 'page' : undefined}>{item.label}</a>;
      })}
      <a class="btn btn--turkuaz" href={url('/iletisim/')}>Teklif al</a>
    </nav>
    <button class="theme-toggle" type="button" aria-pressed="false" aria-label="Koyu mod" title="Koyu / açık mod">
      <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/></svg>
      <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6"/></g></svg>
    </button>
  </div>
</header>
<script>
  // Koyu / açık mod: tercih localStorage 'tema' anahtarında
  const tt = document.querySelector<HTMLButtonElement>('.theme-toggle');
  const syncTheme = () => tt?.setAttribute('aria-pressed', String(document.documentElement.dataset.theme === 'dark'));
  syncTheme();
  tt?.addEventListener('click', () => {
    const dark = document.documentElement.dataset.theme !== 'dark';
    document.documentElement.dataset.theme = dark ? 'dark' : 'light';
    try { localStorage.setItem('tema', dark ? 'dark' : 'light'); } catch (e) {}
    syncTheme();
  });
  const btn = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('ana-menu');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    btn.setAttribute('aria-label', open ? 'Menüyü aç' : 'Menüyü kapat');
    menu?.setAttribute('data-open', String(!open));
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') { btn.click(); btn.focus(); }
  });
</script>
