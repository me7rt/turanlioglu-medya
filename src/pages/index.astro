---
import Base from '../layouts/Base.astro';
import Img from '../components/Img.astro';
import HeroGallery from '../components/HeroGallery.astro';
import WorkStrip from '../components/WorkStrip.astro';
import Faq from '../components/Faq.astro';
import CtaBand from '../components/CtaBand.astro';
import Arcs from '../components/Arcs.astro';
import Badge from '../components/Badge.astro';
import StepIcon from '../components/StepIcon.astro';
import { site, services, faq, process } from '../data/site';
import { url } from '../lib/url';
import { imgSrc } from '../data/images';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---
<Base
  title="Turanlıoğlu Medya | Sosyal medya, web ve dijital reklam ajansı"
  description="Turanlıoğlu Medya; sosyal medya yönetimi, web tasarım, dijital reklam, içerik üretimi ve SEO/GEO hizmetleri sunan İstanbul merkezli dijital ajanstır."
>
  <section class="hero" data-hero aria-labelledby="hero-baslik">
    <HeroGallery />
    <div class="hero-veil" aria-hidden="true"></div>
    <Arcs class="hero-arcs" tone="dark" />
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1 id="hero-baslik">Markanızın sesi dijitalde daha uzağa ulaşsın.</h1>
        <p class="hero-lead" data-intro>{site.tagline} Sosyal medyadan web sitenize, reklamdan aramalara kadar tek bir plan, tek bir ekip.</p>
        <div class="hero-actions" data-intro>
          <a class="btn" href={url('/iletisim/')}>Ücretsiz ön görüşme planla</a>
          <a class="btn btn--ghost" href={url('/hizmetler/')}>Hizmetleri incele</a>
        </div>
        <a class="scroll-hint" href="#ne-yapiyoruz" data-intro data-scroll-hint>
          Aşağı kaydır
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 5v14M6 13l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      </div>
    </div>
  </section>

  <div class="hero-photo-wrap">
    <div class="hero-photo" data-grow>
      <Img name="hero" eager sizes="100vw" ratio="21/9" />
    </div>
    <div class="wrap hero-badge-row"><Badge class="hero-badge" /></div>
  </div>

  <section class="section stage on-dark" id="ne-yapiyoruz" aria-labelledby="hizmetler-baslik">
    <div class="stage-glow" aria-hidden="true"></div>
    <Arcs class="stage-arcs" tone="light" />
    <div class="wrap">
      <div class="section-head">
        <h2 id="hizmetler-baslik" data-rgb>Ne yapıyoruz?</h2>
        <p class="lead" data-reveal>Beş hizmet, tek strateji. İhtiyacınıza göre birini ya da hepsini birlikte alabilirsiniz.</p>
      </div>
      <div class="explorer" data-explorer>
        <ul class="service-list ex-list">
          {services.map((s, i) => (
            <li class:list={{ active: i === 0 }}>
              <a href={url(`/hizmetler/${s.slug}/`)} data-cursor="İncele">
                <h3>{s.name}</h3>
                <p>{s.short}</p>
                <span class="more" aria-hidden="true">
                  <svg viewBox="0 0 24 24" width="28" height="28"><path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
                <span class="ex-progress" aria-hidden="true"></span>
              </a>
            </li>
          ))}
        </ul>
        <div class="ex-panel" aria-hidden="true">
          {services.map((s, i) => (
            <div class:list={['ex-slide', { active: i === 0 }]}>
              <div class="ex-img"><Img name={s.image} sizes="(min-width: 900px) 45vw, 1px" ratio="4/3" /></div>
              <div class="ex-body">
                <p class="ex-short">{s.short}</p>
                <ul class="ex-chips">{s.includes.slice(0, 4).map((x) => <li>{x}</li>)}</ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="work on-dark" aria-labelledby="isler-baslik">
    <div class="wrap work-head">
      <div>
        <p class="kicker">Neler üretiyoruz</p>
        <h2 id="isler-baslik" data-scramble>Seçili işler</h2>
      </div>
      <div class="work-intro">
        <p>Şimdilik her hizmetten örnek ekranlar var. Gerçek müşteri projeleri; problem, yaklaşım ve ölçülen sonuçlarıyla buraya gelecek.</p>
        <p class="todo">[DOLDURULACAK: izin alınmış 3–4 gerçek proje]</p>
      </div>
    </div>
    <WorkStrip />
  </section>

  <section class="section process" aria-labelledby="surec-baslik">
    <Arcs class="process-arcs" tone="dark" />
    <div class="wrap">
      <div class="section-head">
        <h2 id="surec-baslik" data-rgb>Nasıl çalışıyoruz?</h2>
        <p class="lead" data-reveal>Her iş aynı dört adımdan geçer; ne zaman ne olacağını baştan bilirsiniz.</p>
      </div>
      <div class="steps-line" aria-hidden="true"><span class="steps-dot"></span></div>
      <ol class="steps" data-hscroll>
        {process.map((p, i) => (
          <li data-line>
            <StepIcon n={i} />
            <span class="step-no" aria-hidden="true" data-count>{i + 1}</span>
            <h3>{p.title}</h3>
            <p>{p.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section blog-teaser" aria-labelledby="blog-baslik">
      <div class="wrap">
        <div class="section-head">
          <h2 id="blog-baslik" data-scramble>Rehberler</h2>
          <p class="lead"><a href={url('/blog/')}>Tüm yazılar</a></p>
        </div>
        <ul class="post-list" data-stagger>
          {posts.map((p) => (
            <li>
              <a href={url(`/blog/${p.id}/`)} data-cursor="Oku">
                <div class="zoom"><Img name={p.data.image} sizes="(min-width: 900px) 33vw, 100vw" ratio="3/2" /></div>
                <p class="pill pill--light">{p.data.category}</p>
                <h3>{p.data.title}</h3>
                <p class="muted">{p.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section" aria-labelledby="sss-baslik">
    <div class="wrap faq-grid">
      <div>
        <h2 id="sss-baslik" data-scramble>Sık sorulan sorular</h2>
        <p class="lead"><a href={url('/sss/')}>Tüm sorular</a></p>
      </div>
      <Faq items={faq} />
    </div>
  </section>

  <CtaBand />
</Base>

<style>
  .hero { background: var(--turkuaz); overflow: hidden; isolation: isolate; }
  /* Yazıların arkasında soldan sağa açılan turkuaz perde: arkadan kayan görseller hafifçe seçilir */
  .hero-veil { position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(90deg, rgb(64 224 208 / 0.86) 0%, rgb(64 224 208 / 0.78) 32%, rgb(64 224 208 / 0.58) 48%, rgb(48 213 200 / 0.22) 66%, rgb(48 213 200 / 0) 82%); }
  @media (max-width: 900px) { .hero-veil { background: linear-gradient(180deg, rgb(64 224 208 / 0.82), rgb(64 224 208 / 0.74) 70%, rgb(64 224 208 / 0.4)); } }
  .hero :global(.hero-arcs) { left: -3%; bottom: 0; width: min(55vw, 560px); z-index: 1; }
  .hero-photo-wrap { position: relative; }
  .hero-badge-row { position: absolute; left: 0; right: 0; top: 0; display: flex; justify-content: flex-end; pointer-events: none; z-index: 2; }
  .hero-badge-row :global(.badge) { pointer-events: auto; transform: translateY(-50%); }
  .hero-grid {
    display: grid; grid-template-columns: minmax(0, 46rem); align-items: center; min-height: clamp(560px, 82vh, 820px);
    padding-block: clamp(2rem, 1rem + 3vw, 4rem) clamp(3rem, 2rem + 4vw, 6rem);
  }
  .hero h1 { font-size: clamp(3rem, 1.4rem + 4.6vw, 6.4rem); line-height: 0.92; letter-spacing: -0.04em; margin-bottom: 0.4em; font-variation-settings: 'wdth' 85; }
  .hero-lead { font-size: var(--fs-1); max-width: 46ch; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }
  .hero .btn--ghost:hover { background: var(--petrol); }

  .hero-photo { position: relative; }
  .hero-photo :global(.img-frame) { border-radius: 0; }
  .hero-grid { position: relative; z-index: 2; }

  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: end; gap: 1rem 3rem; margin-bottom: 3rem; }
  .section-head h2 { margin: 0; }
  .section-head .lead { margin: 0; max-width: 42ch; }

  .service-list { list-style: none; margin: 0; padding: 0; border-top: 2px solid rgb(64 224 208 / 0.5); }
  .service-list li { border-bottom: 1px solid rgb(255 255 255 / 0.12); }
  .service-list a {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr) auto; gap: 1rem 3rem; align-items: center;
    padding: 1.75rem 0; text-decoration: none;
    transition: padding 0.3s var(--ease), background 0.3s var(--ease);
  }
  .service-list h3 { margin: 0; font-size: var(--fs-3); }
  .service-list h3 { color: var(--beyaz); }
  .service-list p { margin: 0; color: #b9d6d3; }
  .service-list .more { display: grid; place-items: center; width: 56px; height: 56px; border-radius: 50%; border: 2px solid rgb(64 224 208 / 0.6); color: var(--turkuaz); transition: background 0.3s var(--ease), color 0.3s; }
  .service-list a:hover { background: var(--turkuaz-50); padding-inline: 1.25rem; }
  .service-list a:hover h3 { color: var(--turkuaz); }
  .service-list a:hover .more { color: var(--petrol); }
  .service-list a:hover .more { background: var(--turkuaz); border-color: var(--turkuaz); }
  @media (max-width: 820px) {
    .service-list a { grid-template-columns: 1fr auto; }
    .service-list p { grid-column: 1 / -1; grid-row: 2; }
    .service-list .more { width: 44px; height: 44px; grid-row: 1; grid-column: 2; }
  }

  /* Seçili işler: şerit bölümü baştan sona kaplar; yazılar solda petrolden turkuaza açılan perdenin üstünde */
  /* Seçili işler: başlık üstte, kayan şerit altta ve bölümü baştan sona kaplar */
  .work { position: relative; overflow: hidden; isolation: isolate; padding-top: clamp(4rem, 7vw, 7rem);
    background: linear-gradient(90deg, var(--petrol) 0%, var(--petrol-2) 55%, var(--turkuaz-700) 100%); color: #c9e2df; }
  .work-head { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem clamp(2rem, 6vw, 6rem); align-items: end; }
  .work-head h2 { font-size: var(--fs-4); color: var(--beyaz); margin: 0; }
  .work-intro p:last-child { margin-bottom: 0; }
  .work :global(.ws-scroller) { padding-block: 3rem clamp(4rem, 6vw, 6rem); }
  .work :global(.ws-cap) { color: var(--beyaz); }
  .work :global(.ws-card:hover .ws-cap) { color: var(--turkuaz); }
  @media (max-width: 820px) { .work-head { grid-template-columns: 1fr; } }

  /* Hizmetler: koyu sahne */
  .stage { position: relative; overflow: hidden; isolation: isolate; background: var(--petrol); color: #c9e2df; }
  .stage h2 { color: var(--beyaz); }
  .stage .lead { color: #b9d6d3; }
  .stage-glow { position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background:
      radial-gradient(40% 40% at 85% 20%, rgb(64 224 208 / 0.22), transparent 70%),
      radial-gradient(35% 45% at 5% 95%, rgb(27 111 103 / 0.5), transparent 70%); }
  .stage :global(.stage-arcs) { right: -4%; top: -6%; width: min(50vw, 520px); transform: scale(-1, -1); z-index: -1; }
  .process { position: relative; overflow: hidden; isolation: isolate; }
  .process :global(.process-arcs) { right: -4%; bottom: -4%; width: min(46vw, 480px); transform: scaleX(-1); z-index: -1; }

  .process { background: var(--turkuaz-50); }
  /* Kartların üstünde 1→4 akan sinyal çizgisi */
  .steps-line { position: relative; height: 2px; margin: 0 0 1.75rem; background: rgb(6 42 45 / 0.12); }
  .steps-line::before { content: ''; position: absolute; inset: 0; background: var(--turkuaz-700); transform-origin: left; transform: scaleX(var(--draw, 0)); }
  .steps-dot { position: absolute; top: 50%; left: 0; width: 14px; height: 14px; margin: -7px 0 0 -7px; border-radius: 50%; background: var(--turkuaz); box-shadow: 0 0 0 4px rgb(64 224 208 / 0.3), 0 0 18px var(--turkuaz); opacity: 0; }
  :global(.no-motion) .steps-line::before { transform: none; }
  @media (max-width: 1000px) { .steps-line { display: none; } }
  .steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; counter-reset: s; }
  .steps li { border-top: 4px solid var(--turkuaz); padding-top: 1.25rem; }
  .step-no { display: block; font-family: var(--font-display); font-size: var(--fs-4); font-weight: 700; line-height: 1; color: var(--turkuaz-700); margin-bottom: 1rem; }
  .steps h3 { font-size: var(--fs-1); }
  .steps p { color: var(--gri); }

  .post-list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 2rem; }
  .post-list a { text-decoration: none; display: block; }
  .post-list h3 { font-size: var(--fs-2); }
  .post-list .pill { margin: 1.25rem 0 0.75rem; }
  .post-list :global(.img-frame) { border-radius: 14px; }
  .post-list a:hover h3 { color: var(--turkuaz-700); text-decoration: underline; text-decoration-color: var(--turkuaz); text-decoration-thickness: 3px; }

  .faq-grid { display: grid; grid-template-columns: 1fr 1.6fr; gap: 3rem; }

  @media (max-width: 900px) {
    .hero-grid, .faq-grid { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr 1fr; }
    .post-list { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) { .steps { grid-template-columns: 1fr; } }
</style>
<style>
  /* Hizmet gezgini: solda liste, sağda yapışkan önizleme paneli. Kaydırmayı hiç durdurmaz. */
  .explorer { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .ex-list { position: relative; }
  .ex-list li { position: relative; transition: opacity 0.4s var(--ease); }
  .ex-list a { grid-template-columns: 1fr auto !important; padding: 1.4rem 0 !important; position: relative; }
  .ex-list p { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .ex-list h3 { transition: transform 0.5s var(--ease), color 0.3s; }
  .explorer.js .ex-list li:not(.active) h3 { color: #8fb0ad; }
  .explorer.js .ex-list li:not(.active) .more { opacity: 0.4; }
  .ex-list li.active h3 { color: var(--turkuaz); transform: translateX(1rem); }
  .ex-list li.active .more { background: var(--turkuaz); border-color: var(--turkuaz); color: var(--petrol); }
  .ex-progress { position: absolute; left: 0; bottom: -1px; height: 4px; width: 100%; background: var(--turkuaz); transform-origin: left; transform: scaleX(0); }
  .ex-list li.active .ex-progress { transform: scaleX(var(--p, 1)); }
  .ex-list a:hover { background: transparent !important; padding-inline: 0 !important; }

  .ex-panel { position: sticky; top: 110px; display: grid; }
  .ex-slide { grid-area: 1 / 1; opacity: 0; visibility: hidden; }
  .ex-slide.active { opacity: 1; visibility: visible; }
  .ex-img { border-radius: 999px 999px 18px 18px; overflow: hidden; box-shadow: 0 0 0 1px rgb(64 224 208 / 0.5), 0 0 80px -10px rgb(64 224 208 / 0.45); }
  .ex-img :global(.img-frame) { border-radius: inherit; }
  .ex-img :global(img) { transform: scale(1.06); }
  .ex-body { padding-top: 1.5rem; }
  .ex-short { font-size: var(--fs-1); color: #d7ecea; }
  .ex-chips { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .ex-chips li { padding: 0.45rem 0.9rem; border-radius: 999px; background: rgb(64 224 208 / 0.1); color: var(--turkuaz); box-shadow: inset 0 0 0 1.5px rgb(64 224 208 / 0.5); font-size: 0.9rem; font-weight: 500; }

  @media (max-width: 900px) {
    .explorer { grid-template-columns: 1fr; }
    .ex-panel { display: none; }
    .ex-list p { position: static; width: auto; height: auto; clip: auto; white-space: normal; grid-column: 1 / -1; }
    .explorer.js .ex-list li:not(.active) { opacity: 1; }
    .ex-list li.active h3 { transform: none; }
  }
</style>
