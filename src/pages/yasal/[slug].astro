---
import Base from '../../layouts/Base.astro';
export function getStaticPaths() {
  return [
    { params: { slug: 'gizlilik-politikasi' }, props: { title: 'Gizlilik politikası' } },
    { params: { slug: 'kvkk-aydinlatma-metni' }, props: { title: 'KVKK aydınlatma metni' } },
    { params: { slug: 'cerez-politikasi' }, props: { title: 'Çerez politikası' } },
  ];
}
const { title } = Astro.props;
---
<Base title={title} description={`Turanlıoğlu Medya ${title.toLocaleLowerCase('tr-TR')}. Kişisel verilerinizin nasıl işlendiği ve haklarınız hakkında bilgi.`} crumbs={[{ name: title, path: `/yasal/${Astro.params.slug}/` }]} noindex>
  <div class="wrap prose" style="padding-block:2rem 6rem">
    <h1>{title}</h1>
    <p class="todo">[DOLDURULACAK: Bu metin bir hukukçu tarafından hazırlanmalı. Yayına almadan önce zorunlu — yönerge Bölüm 9 ve kontrol listesi madde 1–3.]</p>
  </div>
</Base>
