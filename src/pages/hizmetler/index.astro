---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import Badge from '../../components/Badge.astro';
import { services } from '../../data/site';
import { url, absUrl } from '../../lib/url';

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Turanlıoğlu Medya hizmetleri',
  itemListElement: services.map((s, i) => ({ '@type': 'ListItem', position: i + 1, name: s.name, url: absUrl(`/hizmetler/${s.slug}/`) })),
}];
---
<Base
  title="Hizmetler: sosyal medya, web, reklam, içerik, SEO/GEO"
  description="Sosyal medya yönetimi, web tasarım, Meta ve Google reklamları, içerik ve video üretimi, SEO ve GEO. Turanlıoğlu Medya'nın tüm hizmetleri tek sayfada."
  crumbs={[{ name: 'Hizmetler', path: '/hizmetler/' }]}
  schema={schema}
  top="dark"
>
  <PageHero title="Hizmetler: beş iş, tek strateji." lead="Turanlıoğlu Medya beş ana hizmet sunar. Her biri tek başına alınabilir; birlikte alındığında tek bir strateji altında yürür.">
    <Badge slot="side" />
  </PageHero>
  <div class="wrap svc">
    {services.map((s, i) => (
      <article class:list={['svc-row', { flip: i % 2 === 1 }]}>
        <div class="svc-media blob" data-curtain><div class="arch zoom"><Img name={s.image} sizes="(min-width: 900px) 40vw, 100vw" ratio="4/5" /></div></div>
        <div data-reveal>
          <span class="svc-no" aria-hidden="true">0{i + 1}</span>
          <h2><a href={url(`/hizmetler/${s.slug}/`)} data-cursor="İncele">{s.name}</a></h2>
          <p>{s.short}</p>
          <p class="muted">{s.forWhom}</p>
          <a class="btn btn--ghost" href={url(`/hizmetler/${s.slug}/`)}>{s.name} detayları</a>
        </div>
      </article>
    ))}
  </div>
  <CtaBand />
</Base>
<style>
  .svc { display: grid; gap: clamp(4rem, 8vw, 8rem); padding-block: clamp(4rem, 8vw, 8rem); }
  .svc-media { max-width: 460px; justify-self: center; width: 100%; }
  .svc-row.flip .svc-media::before { inset: 8% 8% -6% -6%; }
  .svc-no { display: block; font-family: var(--font-display); font-weight: 700; font-size: clamp(4rem, 3rem + 4vw, 7.5rem); line-height: 0.8; letter-spacing: -0.05em; color: transparent; -webkit-text-stroke: 2px var(--turkuaz-700); margin-bottom: 1.25rem; }
  .svc-row h2 { font-size: var(--fs-4); }
  .svc-row { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .svc-row.flip > :first-child { order: 2; }
  .svc-row h2 a { text-decoration: none; }
  .svc-row h2 a:hover { color: var(--turkuaz-700); text-decoration: underline; text-decoration-color: var(--turkuaz); text-decoration-thickness: 3px; }
  @media (max-width: 820px) { .svc-row { grid-template-columns: 1fr; } .svc-row.flip > :first-child { order: 0; } }
</style>
