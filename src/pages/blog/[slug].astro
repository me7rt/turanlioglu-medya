---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import Faq from '../../components/Faq.astro';
import PostMeta from '../../components/PostMeta.astro';
import CtaBand from '../../components/CtaBand.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection, render } from 'astro:content';
import { absUrl, url } from '../../lib/url';
import { imgSrc } from '../../data/images';
import { site } from '../../data/site';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const d = post.data;
const path = `/blog/${post.id}/`;
const toc = headings.filter((h) => h.depth === 2);

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: d.title,
  description: d.description,
  image: imgSrc(d.image, 1600),
  datePublished: d.date.toISOString(),
  dateModified: (d.updated ?? d.date).toISOString(),
  inLanguage: 'tr-TR',
  mainEntityOfPage: absUrl(path),
  articleSection: d.category,
  author: { '@type': 'Person', name: d.author, '@id': absUrl('/hakkimizda/#mert'), url: absUrl('/hakkimizda/') },
  publisher: { '@id': absUrl('/#kurum') },
}];
---
<Base
  title={d.title}
  description={d.description}
  ogType="article"
  image={imgSrc(d.image, 1200)}
  crumbs={[{ name: 'Blog', path: '/blog/' }, { name: d.title, path }]}
  schema={schema}
  top="dark"
>
  <article>
    <PageHero compact title={d.title} lead={d.description}>
      <p class="pill" slot="before">{d.category}</p>
      <div data-intro><PostMeta date={d.date} updated={d.updated} author={d.author} /></div>
    </PageHero>
  <div class="wrap article">
    <div data-intro class="article-img"><Img name={d.image} eager sizes="(min-width: 1320px) 1272px, 100vw" ratio="2/1" /></div>

    <div class="article-body">
      <aside class="toc" aria-label="İçindekiler">
        {toc.length > 0 && (
          <nav>
            <p class="toc-title">Bu yazıda</p>
            <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
          </nav>
        )}
      </aside>
      <div>
        {d.summary && (
          <section class="summary" aria-labelledby="kisaca" data-reveal data-nosplit>
            <h2 id="kisaca">Kısaca</h2>
            <ul>{d.summary.map((s) => <li>{s}</li>)}</ul>
          </section>
        )}
        <div class="prose"><Content /></div>

        {d.faq && d.faq.length > 0 && (
          <section class="post-faq" aria-labelledby="yazi-sss">
            <h2 id="yazi-sss">Sık sorulan sorular</h2>
            <Faq items={d.faq} />
          </section>
        )}

        <aside class="author-box" aria-label="Yazar hakkında" data-reveal>
          <p><strong>{d.author}</strong>, {site.name}'nın kurucusudur. <a href={url('/hakkimizda/')}>Hakkımızda sayfasında</a> deneyimini okuyabilirsiniz.</p>
        </aside>
      </div>
    </div>
  </div>
  </article>
  <CtaBand title="Siteniz yapay zekâ aramalarında görünüyor mu?" text="Sitenizi SEO ve GEO açısından birlikte inceleyelim; nereden başlamanız gerektiğini somut adımlarla paylaşalım." />
</Base>
<style>
  :global(.article-img) { margin: clamp(-6rem, -2rem - 4vw, -2.5rem) 0 4rem; position: relative; z-index: 1; }
  :global(.article-img .img-frame) { border-radius: 18px; box-shadow: 0 40px 80px -40px rgb(6 42 45 / 0.6); }
  .article-body { display: grid; grid-template-columns: 240px minmax(0, 720px); gap: 4rem; padding-bottom: 5rem; }
  .toc nav { position: sticky; top: 96px; font-size: 0.95rem; }
  .toc-title { font-weight: 600; margin-bottom: 0.75rem; }
  .toc ol { margin: 0; padding-left: 1.1em; display: grid; gap: 0.5rem; }
  .toc a { text-decoration: none; color: var(--gri); }
  .toc a:hover { color: var(--turkuaz-700); text-decoration: underline; }
  .toc nav { border-left: 3px solid var(--turkuaz); padding-left: 1rem; }
  .summary { position: relative; overflow: hidden; background: var(--turkuaz); padding: 1.75rem 2rem; border-radius: 18px; margin-bottom: 2.5rem; }
  .summary::after { content: ''; position: absolute; right: -60px; top: -60px; width: 180px; height: 180px; border-radius: 50%; border: 1.5px solid rgb(6 42 45 / 0.25); box-shadow: 0 0 0 30px rgb(6 42 45 / 0.04), 0 0 0 31.5px rgb(6 42 45 / 0.18); pointer-events: none; }
  .summary h2 { font-size: var(--fs-1); margin-bottom: 0.75rem; }
  .summary ul { margin: 0; padding-left: 1.2em; display: grid; gap: 0.6rem; }
  .post-faq { margin-top: 4rem; }
  .post-faq h2 { font-size: var(--fs-2); }
  .author-box { margin-top: 3rem; padding: 1.75rem; border-left: 6px solid var(--turkuaz); border-radius: 18px; background: var(--petrol); color: #c9e2df; }
  .author-box strong { color: var(--beyaz); }
  .author-box a { color: var(--turkuaz); font-weight: 600; }
  .author-box p { margin: 0; }
  @media (max-width: 960px) { .article-body { grid-template-columns: 1fr; gap: 0; } .toc { display: none; } }
</style>
