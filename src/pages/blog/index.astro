---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import PostMeta from '../../components/PostMeta.astro';
import PageHero from '../../components/PageHero.astro';
import { getCollection } from 'astro:content';
import { url, absUrl } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Turanlıoğlu Medya Blog',
  url: absUrl('/blog/'),
  inLanguage: 'tr-TR',
  publisher: { '@id': absUrl('/#kurum') },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: absUrl(`/blog/${p.id}/`), datePublished: p.data.date.toISOString() })),
}];
---
<Base
  title="Blog ve rehberler: sosyal medya, reklam, SEO ve GEO"
  description="Sosyal medya, web, dijital reklam, SEO ve GEO üzerine sahadan, uygulanabilir rehberler. Turanlıoğlu Medya ekibinin deneyimleriyle yazıldı."
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
  schema={schema}
  top="dark"
>
  <PageHero title="Blog ve rehberler" lead="Sahada gördüklerimizi, uygulanabilir adımlara çevirerek yazıyoruz." />
  <div class="wrap section">
    <ul class="posts">
      {posts.map((p, i) => (
        <li>
          <a href={url(`/blog/${p.id}/`)} class:list={['post-card', { featured: i === 0 }]} data-cursor="Oku">
            <div class="zoom post-img" data-curtain><Img name={p.data.image} sizes="(min-width: 900px) 55vw, 100vw" ratio="3/2" /></div>
            <div class="post-body" data-reveal>
              <p class="pill pill--light">{p.data.category}</p>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <PostMeta date={p.data.date} updated={p.data.updated} author={p.data.author} />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .posts { list-style: none; margin: clamp(-8rem, -3rem - 5vw, -3rem) 0 0; padding: 0; display: grid; gap: 3rem; position: relative; z-index: 1; }
  .post-card { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 0; align-items: stretch; text-decoration: none; background: var(--beyaz); border-radius: 18px; overflow: hidden; box-shadow: 0 30px 70px -35px rgb(6 42 45 / 0.5); transition: transform 0.5s var(--ease), box-shadow 0.5s var(--ease); }
  .post-card:hover { transform: translateY(-6px); box-shadow: 0 40px 80px -35px rgb(6 42 45 / 0.6), 0 0 0 3px var(--turkuaz); }
  .post-img :global(.img-frame) { height: 100%; border-radius: 0; }
  .post-img :global(img) { height: 100%; object-fit: cover; }
  .post-body { padding: clamp(1.5rem, 4vw, 3.5rem); display: flex; flex-direction: column; justify-content: center; }
  .post-card h2 { font-size: var(--fs-3); }
  .post-card:hover h2 { color: var(--turkuaz-700); text-decoration: underline; text-decoration-color: var(--turkuaz-2); text-decoration-thickness: 3px; }
  .pill { align-self: flex-start; margin-bottom: 1rem; }
  @media (max-width: 820px) { .post-card { grid-template-columns: 1fr; } }
</style>
