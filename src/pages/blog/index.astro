---
import Base from '../../layouts/Base.astro';
import Img from '../../components/Img.astro';
import PostMeta from '../../components/PostMeta.astro';
import { getCollection } from 'astro:content';
import { url, absUrl } from '../../lib/url';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const schema = [{
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'Turanlıoğlu Medya Blog',
  url: absUrl('/blog/'),
  inLanguage: 'tr-TR',
  publisher: { '@id': absUrl('/#kurum') },
  blogPost: posts.map((p) => ({ '@type': 'BlogPosting', headline: p.data.title, url: absUrl(`/blog/${p.id}/`), datePublished: p.data.date.toISOString() })),
}];
---
<Base
  title="Blog ve rehberler: sosyal medya, reklam, SEO ve GEO"
  description="Sosyal medya, web, dijital reklam, SEO ve GEO üzerine sahadan, uygulanabilir rehberler. Turanlıoğlu Medya ekibinin deneyimleriyle yazıldı."
  crumbs={[{ name: 'Blog', path: '/blog/' }]}
  schema={schema}
>
  <div class="wrap section" style="padding-top:2rem">
    <h1>Blog ve rehberler</h1>
    <p class="lead" data-intro>Sahada gördüklerimizi, uygulanabilir adımlara çevirerek yazıyoruz.</p>
    <ul class="posts">
      {posts.map((p) => (
        <li>
          <a href={url(`/blog/${p.id}/`)} class="post-card" data-cursor="Oku">
            <div data-curtain><Img name={p.data.image} sizes="(min-width: 900px) 40vw, 100vw" ratio="3/2" /></div>
            <div data-reveal>
              <p class="cat">{p.data.category}</p>
              <h2>{p.data.title}</h2>
              <p>{p.data.description}</p>
              <PostMeta date={p.data.date} updated={p.data.updated} author={p.data.author} />
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .posts { list-style: none; margin: 3rem 0 0; padding: 0; display: grid; gap: 3rem; }
  .post-card { display: grid; grid-template-columns: 1fr 1.2fr; gap: 2.5rem; align-items: center; text-decoration: none; }
  .post-card h2 { font-size: var(--fs-3); }
  .post-card:hover h2 { color: var(--turkuaz-700); text-decoration: underline; text-decoration-color: var(--turkuaz-2); text-decoration-thickness: 3px; }
  .cat { margin-bottom: 0.5rem; }
  @media (max-width: 820px) { .post-card { grid-template-columns: 1fr; gap: 1.25rem; } }
</style>
